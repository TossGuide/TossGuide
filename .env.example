# Copy to .env (gitignored) and fill in. Real environment variables override .env.
# Server port. The deploy script uses 8080.
PORT=8787
# Leaderboard in PostgreSQL (recommended on a server). Leave empty to use the JSON file below.
#   sudo -u postgres psql -c "CREATE ROLE trashify LOGIN PASSWORD '<random>';" -c "CREATE DATABASE trashify OWNER trashify;"
DATABASE_URL=
# Leaderboard JSON file, used only when DATABASE_URL is empty.
DATA_FILE=server/data/scans.json
# "true" when requests come through a proxy (Vercel, Cloudflare tunnel), so rate limits see real client IPs.
TRUST_PROXY=false
# No API keys are needed: the model runs in the browser.
